{
  "name": "white-diamond",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev -p 3001",
    "dev:no-turbo": "node init && next dev -p 3001 --turbo false",
    "build": "node init && node -e \"try{require('fs').rmSync('.next/dev',{recursive:true,force:true})}catch(e){}\" && npx prisma generate && next build --webpack",
    "start": "node init && next start",
    "lint": "eslint",
    "postinstall": "npx prisma generate",
    "db:up": "docker compose up -d --wait",
    "db:push": "prisma db push",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:studio": "prisma studio",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "next": "16.1.6",
    "next-intl": "^4.14.9",
    "nodemailer": "^6.9.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.29",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
