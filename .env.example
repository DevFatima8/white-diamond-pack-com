# Copy this file to .env and fill in real values. Never commit .env.

# ── Database (MySQL / Prisma) ─────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Legacy split DB settings (not used by Prisma; kept for reference)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Cloudinary (product image uploads) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin login ───────────────────────────────────────────
# At least one of ADMIN_EMAIL / ADMIN_USERNAME is required.
ADMIN_EMAIL=
ADMIN_USERNAME=

# Recommended: bcrypt hash generated with `npm run hash-password`.
# In .env every "$" in the hash must be written as "\$" (the script does this for you).
ADMIN_PASSWORD_HASH=
# Fallback only (plain text) — used when ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

# ── Forms (legacy, Formspree) ─────────────────────────────
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT=
