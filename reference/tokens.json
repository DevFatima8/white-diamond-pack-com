{
  "name": "FalconPack Design System Tokens",
  "source": "https://falconpack.com/",
  "version": "1.0.0",
  "colors": {
    "primary": {
      "red": "#E63946",
      "redRgb": "rgb(230, 57, 70)",
      "redDark": "#C92A37",
      "redLight": "#FEE2E2"
    },
    "accent": {
      "purple": "#6366F1",
      "purpleHover": "#4F46E5",
      "purpleAlt": "#818CF8"
    },
    "neutral": {
      "navy": "#1E1B4B",
      "headerDark": "#12102E",
      "footerDark": "#12102E",
      "white": "#FFFFFF",
      "lavender": "#EEF2FF",
      "lavenderLight": "#F8FAFC",
      "gray300": "#CBD5E1",
      "gray400": "#94A3B8",
      "gray500": "#64748B",
      "scrollbar": "#6366F1"
    }
  },
  "typography": {
    "fontFamilies": {
      "heading": "OrkneyBold, GothamBold, Outfit, sans-serif",
      "body": "GothamBookRegular, Plus Jakarta Sans, Arial, sans-serif",
      "black": "GothamBlack, Outfit, sans-serif",
      "arabic": "Cairo, Noto Kufi Arabic, sans-serif"
    },
    "fontWeights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "black": "900"
    },
    "scale": {
      "heroTitle": "clamp(2rem, 5vw, 4.5rem)",
      "sectionTitle": "clamp(1.75rem, 3.5vw, 3rem)",
      "subtitle": "clamp(1.125rem, 2vw, 1.5rem)",
      "bodyLarge": "1.125rem",
      "body": "1rem",
      "bodySmall": "0.875rem",
      "nav": "13px",
      "badge": "10px"
    },
    "lineHeights": {
      "tight": "1.12",
      "snug": "1.25",
      "normal": "1.5",
      "relaxed": "1.65"
    }
  },
  "layout": {
    "container": {
      "mobile": "90%",
      "tablet": "85%",
      "desktop": "80%",
      "maxWidth": "1280px"
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },
    "spacing": {
      "sectionY": "clamp(3rem, 6vw, 6rem)",
      "gapSmall": "1rem",
      "gapMedium": "2rem",
      "gapLarge": "3.5rem"
    },
    "borderRadius": {
      "sm": "0.5rem",
      "md": "0.75rem",
      "lg": "1rem",
      "xl": "1.5rem",
      "full": "9999px"
    },
    "shadows": {
      "card": "0 4px 20px -2px rgba(14, 19, 13, 0.08)",
      "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
      "glow": "0 0 25px rgba(125, 194, 66, 0.35)"
    }
  },
  "header": {
    "heightDesktop": "64px",
    "heightMobile": "60px",
    "navWidth": "58%",
    "navItemFontSize": "13px",
    "background": "#0e130d"
  },
  "footer": {
    "background": "#1d221e",
    "textColor": "#e8f0e6",
    "mutedTextColor": "#a5c9b5"
  }
}
